{
  "name": "pi-sdd",
  "version": "0.1.0",
  "description": "Opt-in spec-driven engineering workflows for pi.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "pi": {
    "extensions": [
      "./extensions/sdd.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:acceptance": "node --test test/pi-load.test.ts test/acceptance.test.ts",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "files": [
    "package.json", "package-lock.json", "extensions", "src", "skills",
    "policies", "templates", "README.md", "docs", "install.sh",
    "scripts/archive.ts", "LICENSE", "NOTICE", "upstream.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "typebox": "1.3.27"
  }
}
